NEXT_PUBLIC_SUPABASE_URL=აქ_ჩასვი_Supabase_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=აქ_ჩასვი_Supabase_anon_key
NEXO_PROXY_SECRET=replace_with_your_proxy_secret
# Server only: saves the initial OnWay fee without granting operators fee-edit rights.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# OnWay courier API (required for sending orders to OnWay).
ONWAY_API_USERNAME=replace_with_your_onway_username
ONWAY_API_KEY=replace_with_your_onway_api_key
# Optional OnWay settings. If omitted, the defaults in app/api/onway/send/route.ts are used.
# ONWAY_PAYMENT=3
# ONWAY_PAYER=3
# ONWAY_FROM_CITY=
# ONWAY_FROM_NAME=
# ONWAY_FROM_ADDRESS=
# ONWAY_FROM_COMPANY=
